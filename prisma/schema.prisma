generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid())
  name     String
  bookings Booking[]
}

model Venue {
  id        String @id @default(uuid())
  name      String
  location  String
  sportType String
  slots     Slot[]
}

model Slot {
  id        String   @id @default(uuid())
  venueId   String
  date      DateTime
  startTime String
  endTime   String
  booking   Booking?
  venue     Venue    @relation(fields: [venueId], references: [id])

  @@index([venueId])
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  slotId    String   @unique
  createdAt DateTime @default(now())
  slot      Slot     @relation(fields: [slotId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
